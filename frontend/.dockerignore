# Indispensable : node_modules installé sous Windows contient des binaires
# compilés pour la plateforme, qui casseraient npm dans l'image Linux.
node_modules
dist

# Les valeurs VITE_* arrivent par arguments de build, pas par ces fichiers.
# .env.test ne sert qu'à vitest, et l'image ne lance aucun test.
.env*

*.md
.gitignore
LICENSE
coverage
